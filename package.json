{
  "name": "ripper-gift-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Daily archiver/downloader for the gift section of forum.ripper.store (FlareSolverr + Cloudflare aware)",
  "scripts": {
    "setup": "node src/setup.js",
    "discover": "node src/discover.js",
